cmake_minimum_required(VERSION 3.20)

# Match the original shell check: case-insensitive substrings in code, with
# comments removed. CMake makes the check available wherever the project builds.
if(NOT DEFINED KERNEL_DIR)
  set(KERNEL_DIR "${CMAKE_CURRENT_LIST_DIR}/../kernel")
endif()
file(GLOB_RECURSE sources "${KERNEL_DIR}/*.h" "${KERNEL_DIR}/*.cpp")
if(NOT sources)
  message(FATAL_ERROR "kernel purity: no kernel sources found in ${KERNEL_DIR}")
endif()
set(words "midi|sysex|velocity|tempo|note|clip|track|synth|chord|pitch|transcript")
set(hits "")
foreach(source IN LISTS sources)
  file(READ "${source}" remaining)
  set(in_block FALSE)
  set(line_number 0)
  while(NOT remaining STREQUAL "")
    math(EXPR line_number "${line_number} + 1")
    string(FIND "${remaining}" "\n" newline)
    if(newline EQUAL -1)
      set(line "${remaining}")
      set(remaining "")
    else()
      string(SUBSTRING "${remaining}" 0 ${newline} line)
      math(EXPR next "${newline} + 1")
      string(SUBSTRING "${remaining}" ${next} -1 remaining)
    endif()
    set(code "")
    while(NOT line STREQUAL "")
      if(in_block)
        string(FIND "${line}" "*/" end)
        if(end EQUAL -1)
          break()
        endif()
        math(EXPR next "${end} + 2")
        string(SUBSTRING "${line}" ${next} -1 line)
        set(in_block FALSE)
      else()
        string(FIND "${line}" "//" single)
        string(FIND "${line}" "/*" block)
        if(NOT single EQUAL -1 AND (block EQUAL -1 OR single LESS block))
          string(SUBSTRING "${line}" 0 ${single} prefix)
          string(APPEND code "${prefix}")
          break()
        elseif(NOT block EQUAL -1)
          string(SUBSTRING "${line}" 0 ${block} prefix)
          string(APPEND code "${prefix}")
          math(EXPR next "${block} + 2")
          string(SUBSTRING "${line}" ${next} -1 line)
          set(in_block TRUE)
        else()
          string(APPEND code "${line}")
          break()
        endif()
      endif()
    endwhile()
    string(TOLOWER "${code}" lower)
    if(lower MATCHES "${words}")
      file(RELATIVE_PATH relative "${KERNEL_DIR}/.." "${source}")
      string(APPEND hits "${relative}:${line_number}:${code}\n")
    endif()
  endwhile()
endforeach()
if(NOT hits STREQUAL "")
  message(FATAL_ERROR
    "kernel purity: media vocabulary in kernel code (comments are exempt):\n${hits}")
endif()
message(STATUS "kernel purity: clean")
